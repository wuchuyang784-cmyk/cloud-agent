# ---------------------------------------------------------------------------
# 本地开发配置模板（进 git）
#
#   首次使用：npm run setup:env      # 复制为 .env 并随机生成会话密钥
#   或手工：  copy .env.example .env
#
# .env 不进 git（见 .gitignore），所有机密一律放在 .env 里，不要写回本模板。
# 加载方式：
#   1) 根目录 npm run dev —— 由 scripts/dev.ps1 读取 .env 并注入全部子进程；
#   2) 单独启动某个服务 —— package.json 内已带 node --env-file-if-exists=../../.env。
# ---------------------------------------------------------------------------

# ===== 数据库 =====
# 平台模式必须连接 PostgreSQL；MemoryStore 仅允许非生产 legacy 开发。
# 本机 Docker 只保留了数据库容器 bairui-postgres（见 infra/postgres/README.md）。
DATABASE_URL=postgresql://bairui_app:change-me-local-only@127.0.0.1:5432/bairui

# ===== 会话 =====
# 必须随机且 >= 32 字符。npm run setup:env 会自动生成；生产必须用独立的密钥。
BAIRUI_SESSION_SECRET=replace-me-with-a-random-string-of-at-least-32-chars

# ===== 平台模式与身份认证 =====
# platform 默认：只开放账号、个人空间与客户端资源；Agent 执行、模拟充值关闭。
# legacy 仅供非生产旧功能开发，生产环境拒绝启动。
BAIRUI_PLATFORM_MODE=platform
BAIRUI_AUTH_MODE=better-auth
BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-me-with-an-independent-random-secret
# 直连时留空。仅信任实际反向代理 IP/CIDR，不要填写整个内网。
BAIRUI_TRUSTED_PROXIES=

# ===== Agent 运行时编排（仅非生产 legacy 模式生效）=====
# local  = 本机子进程，平台不碰 docker.sock（默认）
# remote = 由外部编排拉起实例，平台级生产形态
BAIRUI_RUNTIME_DRIVER=local
# pi 引擎本机形态需显式开启（要求本机已安装 pi CLI）；未开启时 pi 默认回退 mock
# BAIRUI_PI_LOCAL=1
# pi 只认官方 provider 环境变量，请勿自定义 Provider Key 变量名
# DEEPSEEK_API_KEY=sk-your-real-key

# ===== 端口覆盖（可选）=====
# 不设置时用默认值：API 8080 / mock-runtime 8090 / runtime-boundary 8091 / 前端 5173
PLATFORM_API_PORT=8080
MOCK_RUNTIME_PORT=8090
RUNTIME_BOUNDARY_PORT=8091

# ===== 前端 =====
# 控制台开发服务器代理目标；不设置时默认 http://127.0.0.1:8080
API_TARGET=http://127.0.0.1:8080

# 模拟调度默认关闭，仅在隔离测试环境启用；白名单为测试账号邮箱。
BAIRUI_SIMULATION_ENABLED=0
BAIRUI_SIMULATION_USERS=
